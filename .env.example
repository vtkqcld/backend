NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Public URL of THIS backend (used for links in emails/SMS)
APP_ORIGIN=http://localhost:3000

# Comma-separated list of frontend origins allowed to call the API (CORS + cookies)
# Example production:
# ALLOWED_ORIGINS=https://store.yourdomain.com,https://owner.yourdomain.com,https://admin.yourdomain.com,https://operator.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://127.0.0.1:5500,http://localhost:5500

# Set to 1 when behind a reverse proxy (Render, Railway, Nginx, etc.)
TRUST_PROXY=0

# Optional: SQLite path (default data/skyworld.db)
# DB_PATH=data/skyworld.db

# Session length in days
SESSION_DAYS=7

# Required in production for password-reset tokens
# RESET_PEPPER=generate-a-long-random-string

# SMTP (optional)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_FROM_NAME=SkyWorld Stall
# SUPPORT_EMAIL=

# SMS (optional)
# SMS_PROVIDER=semaphore
# SEMAPHORE_API_KEY=
# SEMAPHORE_SENDER_NAME=SkyWorld
